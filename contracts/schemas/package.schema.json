{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://platform.example/contracts/package.schema.json",
  "title": "Platform Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packageKey",
    "version",
    "displayName",
    "category",
    "scope",
    "lifecycle",
    "compatibility",
    "dependencies",
    "conflicts",
    "capabilities",
    "configuration"
  ],
  "properties": {
    "packageKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
      "maxLength": 120,
      "description": "Stable, globally unique package identifier; examples: seo.core, construction.projects."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "displayName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ar", "en"],
      "properties": {
        "ar": { "type": "string", "minLength": 1, "maxLength": 160 },
        "en": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "category": {
      "type": "string",
      "enum": ["core", "marketing", "content", "operations", "sector", "integration"]
    },
    "scope": {
      "type": "string",
      "enum": ["tenant", "site"]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationRequires", "disablePolicy", "dataOwnership"],
      "properties": {
        "activationRequires": {
          "type": "array",
          "items": { "type": "string", "enum": ["entitlement", "dependency-check", "seed", "cache-invalidation"] },
          "uniqueItems": true
        },
        "disablePolicy": {
          "type": "string",
          "enum": ["hide-retain", "export-then-disable", "requires-admin-approval"]
        },
        "dataOwnership": {
          "type": "string",
          "enum": ["tenant", "site"]
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "php", "laravel", "tenantSchema"],
      "properties": {
        "platform": { "type": "string", "pattern": "^[~^><=0-9.* ,|-]+$" },
        "php": { "type": "string", "pattern": "^[~^><=0-9.* ,|-]+$" },
        "laravel": { "type": "string", "pattern": "^[~^><=0-9.* ,|-]+$" },
        "tenantSchema": { "type": "string", "pattern": "^[~^><=0-9.* ,|-]+$" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packageKey", "versionConstraint"],
        "properties": {
          "packageKey": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
          "versionConstraint": { "type": "string", "minLength": 1, "maxLength": 80 },
          "required": { "type": "boolean", "default": true }
        }
      },
      "uniqueItems": true
    },
    "conflicts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "adminScreens", "apiScopes", "routes", "events"],
      "properties": {
        "components": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
          "uniqueItems": true
        },
        "adminScreens": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
          "uniqueItems": true
        },
        "apiScopes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9:.-]+$" },
          "uniqueItems": true
        },
        "routes": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
          "uniqueItems": true
        },
        "events": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$" },
          "uniqueItems": true
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "jsonSchema", "defaults"],
      "properties": {
        "schemaVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
        "jsonSchema": { "type": "object" },
        "defaults": { "type": "object" }
      }
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenantSchemaIntroduced": { "type": "string", "minLength": 1 },
        "migrationIdentifiers": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9]{4}_[0-9]{2}_[0-9]{2}_[a-z0-9_]+$" },
          "uniqueItems": true
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?::[a-z][a-z0-9-]*){2}$" },
          "uniqueItems": true
        },
        "sensitiveData": { "type": "boolean", "default": false },
        "externalHosts": {
          "type": "array",
          "items": { "type": "string", "format": "hostname" },
          "uniqueItems": true
        }
      }
    }
  }
}
